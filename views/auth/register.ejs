<%- include('../partials/header') %>
<main class="min-h-screen flex items-center justify-center px-6">
  <div class="glass w-full max-w-md p-8">
    <h1 class="text-2xl font-black text-center mb-2 neon-text">Daftar</h1>
    <p class="text-center text-text2 text-sm mb-8">Buat akun Lakonan — gratis, langsung bisa cari dan buat lakon</p>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="bg-red-400/10 border border-red-400/30 text-red-400 px-4 py-3 rounded-xl text-sm mb-6"><%= error %></div>
    <% } %>
    <form method="POST" action="/register" class="flex flex-col gap-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label class="text-sm font-medium text-text2 mb-1.5 block">Nama</label>
        <input type="text" name="name" class="input-field" placeholder="Nama lengkap" required>
      </div>
      <div>
        <label class="text-sm font-medium text-text2 mb-1.5 block">Email</label>
        <input type="email" name="email" class="input-field" placeholder="kamu@email.com" required autocomplete="email">
      </div>
      <div>
        <label class="text-sm font-medium text-text2 mb-1.5 block">Password</label>
        <input type="password" name="password" class="input-field" placeholder="Minimal 8 karakter" required autocomplete="new-password">
      </div>
      <div>
        <label class="text-sm font-medium text-text2 mb-1.5 block">Konfirmasi Password</label>
        <input type="password" name="confirm" class="input-field" placeholder="Ulangi password" required>
      </div>
      <button type="submit" class="neon-btn w-full py-3 font-semibold mt-2">Daftar</button>
    </form>
    <p class="text-center text-text2 text-sm mt-6">Sudah punya akun? <a href="/login" class="text-accent font-semibold hover:underline">Masuk</a></p>
  </div>
</main>

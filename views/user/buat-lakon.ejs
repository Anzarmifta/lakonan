<%- include('../partials/header') %>
<div class="flex">
  <%- include('../partials/sidebar') %>
  <main class="flex-1 p-6 md:p-10 max-w-3xl mx-auto">
    <h1 class="text-2xl font-black mb-2 neon-text">Buat Lakon Baru</h1>
    <p class="text-text2 text-sm mb-8">Isi detail lakon. Dana reward akan otomatis ditahan dari saldo kamu (escrow) sampai ada pemenang.</p>
    
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="bg-red-400/10 border border-red-400/30 text-red-400 px-4 py-3 rounded-xl text-sm mb-6"><%= error %></div>
    <% } %>

    <form method="POST" action="/lakon/new" enctype="multipart/form-data" class="flex flex-col gap-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label class="text-sm font-medium text-text2 mb-1.5 block">Judul Lakon *</label>
        <input type="text" name="title" class="input-field" placeholder="Contoh: Makan 5 sambal level 10 dalam 3 menit" required minlength="5">
      </div>
      <div>
        <label class="text-sm font-medium text-text2 mb-1.5 block">Kategori</label>
        <select name="category" class="input-field">
          <option value="fun">🎮 Seru-seruan</option>
          <option value="digital">💻 Digital & Kerja</option>
          <option value="fisik">🏃 Fisik & Errands</option>
        </select>
      </div>
      <div>
        <label class="text-sm font-medium text-text2 mb-1.5 block">Deskripsi Tugas</label>
        <textarea name="description" class="input-field" rows="4" placeholder="Jelaskan apa yang harus dikerjakan, aturan, dan cara buktinya..."></textarea>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="text-sm font-medium text-text2 mb-1.5 block">Reward per orang (Rp) *</label>
          <input type="number" id="rewardInput" name="reward" class="input-field" placeholder="25000" required min="1000" oninput="hitungTotal()">
        </div>
        <div>
          <label class="text-sm font-medium text-text2 mb-1.5 block">Butuh berapa orang?</label>
          <input type="number" id="slotsInput" name="slots" class="input-field" value="1" min="1" max="100" oninput="hitungTotal()">
        </div>
      </div>
      <div class="glass p-4 text-sm flex items-center justify-between">
        <span class="text-text2">Total ditahan ke escrow</span>
        <span id="totalEscrow" class="font-bold text-amber-400">Rp0</span>
      </div>
      <p class="text-xs text-text2 -mt-2">Saldo aktif kamu: <span class="text-emerald-400 font-semibold">Rp<%= (user.balance || 0).toLocaleString('id-ID') %></span>. Dana ditahan saat lakon dibuat, dan cair otomatis ke tiap pelakon yang kamu setujui.</p>
      <div>
        <label class="text-sm font-medium text-text2 mb-1.5 block">Deadline</label>
        <input type="date" name="deadline" class="input-field">
      </div>
      <div>
        <label class="text-sm font-medium text-text2 mb-1.5 block">Lampiran (opsional)</label>
        <input type="file" name="attachment" class="input-field">
      </div>
      <button type="submit" class="neon-btn w-full py-3.5 font-semibold text-base mt-2">Buat Lakon & Deposit ke Escrow</button>
    </form>
  </main>
</div>

<script>
function hitungTotal() {
  const r = parseInt(document.getElementById('rewardInput').value) || 0;
  const s = parseInt(document.getElementById('slotsInput').value) || 0;
  const total = r * s;
  document.getElementById('totalEscrow').textContent = 'Rp' + total.toLocaleString('id-ID') + (s > 1 ? ' (' + s + ' orang)' : '');
}
hitungTotal();
</script>

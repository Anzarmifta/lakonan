<%- include('../partials/header') %>
<div class="flex">
  <%- include('../partials/sidebar') %>
  <main class="flex-1 p-6 md:p-10 min-h-screen">
    <h1 class="text-2xl font-black mb-2 neon-text">Dashboard Admin</h1>
    <p class="text-text2 text-sm mb-8">Monitoring penuh platform Lakonan</p>

    <!-- Ringkasan keuangan -->
    <h2 class="text-lg font-bold mb-3">Ringkasan Keuangan</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
      <div class="glass-card p-5">
        <p class="text-text2 text-xs mb-1">Volume Transaksi</p>
        <p class="text-lg font-black text-amber-400">Rp<%= ((total_volume||0)/1000).toFixed(0) %>K</p>
      </div>
      <div class="glass-card p-5">
        <p class="text-text2 text-xs mb-1">Total Deposit</p>
        <p class="text-lg font-black text-emerald-400">Rp<%= ((total_deposits||0)/1000).toFixed(0) %>K</p>
      </div>
      <div class="glass-card p-5">
        <p class="text-text2 text-xs mb-1">Escrow Tertahan</p>
        <p class="text-lg font-black text-violet-400">Rp<%= ((escrow_held||0)/1000).toFixed(0) %>K</p>
      </div>
      <div class="glass-card p-5">
        <p class="text-text2 text-xs mb-1">Total Payout</p>
        <p class="text-lg font-black text-emerald-400">Rp<%= ((total_payouts||0)/1000).toFixed(0) %>K</p>
      </div>
      <div class="glass-card p-5">
        <p class="text-text2 text-xs mb-1">Sengketa Aktif</p>
        <p class="text-lg font-black text-red-400 font-black"><%= disputes.length %></p>
      </div>
      <div class="glass-card p-5">
        <p class="text-text2 text-xs mb-1">User Aktif 7 Hari</p>
        <p class="text-lg font-black text-blue-400"><%= active_users_7d %>/<%= users_count %></p>
      </div>
    </div>

    <!-- Statistik platform -->
    <h2 class="text-lg font-bold mb-3">Statistik Platform</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <div class="glass-card p-5"><p class="text-text2 text-xs">Total Pengguna</p><p class="text-2xl font-black neon-text"><%= users_count %></p></div>
      <div class="glass-card p-5"><p class="text-text2 text-xs">Lakon Aktif</p><p class="text-2xl font-black text-emerald-400"><%= stats?.active_lakons || 0 %></p></div>
      <div class="glass-card p-5"><p class="text-text2 text-xs">Lakon Selesai</p><p class="text-2xl font-black text-violet-400"><%= stats?.completed || 0 %></p></div>
      <div class="glass-card p-5"><p class="text-text2 text-xs">Reward Dibagikan</p><p class="text-2xl font-black text-amber-400">Rp<%= ((stats?.total_reward||0)/1000).toFixed(0) %>K</p></div>
    </div>

    <!-- Status + Kategori breakdown -->
    <div class="grid md:grid-cols-2 gap-6 mb-8">
      <div class="glass p-6">
        <h3 class="font-bold mb-4">Status Lakon</h3>
        <div class="space-y-2">
          <% lakon_status.forEach(function(s) { %>
            <div class="flex justify-between text-sm"><span class="text-text2 capitalize"><%= s.status %></span><span class="font-semibold"><%= s.c %></span></div>
          <% }) %>
          <% if (!lakon_status.length) { %><p class="text-text2 text-sm">Belum ada lakon.</p><% } %>
        </div>
      </div>
      <div class="glass p-6">
        <h3 class="font-bold mb-4">Kategori Lakon</h3>
        <div class="space-y-2">
          <% lakon_category.forEach(function(c) { %>
            <div class="flex justify-between text-sm"><span class="text-text2 capitalize"><%= c.category %></span><span class="font-semibold"><%= c.c %></span></div>
          <% }) %>
          <% if (!lakon_category.length) { %><p class="text-text2 text-sm">Belum ada lakon.</p><% } %>
        </div>
      </div>
    </div>

    <!-- Aktivitas 7 hari -->
    <div class="glass p-6 mb-8">
      <h3 class="font-bold mb-4">Aktivitas Transaksi 7 Hari Terakhir</h3>
      <% if (activity_7d.length) { %>
      <div class="flex items-end gap-2 h-24">
        <% activity_7d.forEach(function(a) { %>
          <% var max = activity_7d.reduce(function(m, x) { return Math.max(m, x.txns || 0); }, 1); %>
          <div class="flex flex-col items-center justify-end flex-1 h-full">
            <div class="w-full bg-violet-500/30 rounded-t-lg" style="height: <%= Math.max(6, ((a.txns||0)/max)*100) %>%"></div>
            <span class="text-[10px] text-text2 mt-1"><%= a.day.slice(5) %></span>
            <span class="text-[10px] font-semibold"><%= a.txns || 0 %></span>
          </div>
        <% }) %>
      </div>
      <% } else { %><p class="text-text2 text-sm">Belum ada transaksi.</p><% } %>
    </div>

    <!-- Sengketa -->
    <h2 class="text-lg font-bold mb-4">Sengketa Aktif (<%= disputes.length %>)</h2>
    <div class="space-y-3 mb-8">
      <% if (disputes.length > 0) { %>
        <% disputes.forEach(function(d) { %>
          <div class="glass-card p-5">
            <div class="flex flex-wrap justify-between items-start gap-3 mb-3">
              <div>
                <p class="font-semibold"><%= d.lakon_title %></p>
                <p class="text-text2 text-xs">Pelapor: <%= d.claimant_name %> &middot; <%= d.reason %></p>
              </div>
              <span class="badge badge-fun"><%= d.status %></span>
            </div>
            <div class="flex gap-2">
              <button onclick="resolveDispute(<%= d.id %>, 'refund')" class="emerald-btn px-4 py-1.5 text-xs font-semibold">Refund Escrow</button>
              <button onclick="resolveDispute(<%= d.id %>, 'dismiss')" class="px-4 py-1.5 rounded-xl border border-border text-text2 text-xs">Dismiss</button>
            </div>
          </div>
        <% }); %>
      <% } else { %><p class="text-text2 text-sm">Tidak ada sengketa.</p><% } %>
    </div>

    <!-- Transaksi terbaru -->
    <h2 class="text-lg font-bold mb-4">Transaksi Terbaru</h2>
    <div class="space-y-2">
      <% transactions.forEach(function(t) { %>
        <div class="flex justify-between text-sm p-3 glass rounded-xl">
          <span><%= t.user_name %> <span class="text-text2 text-xs">— <%= t.type %></span></span>
          <span class="<%= t.amount >= 0 ? 'text-emerald-400' : 'text-red-400' %>">Rp<%= Math.abs(t.amount).toLocaleString('id-ID') %></span>
        </div>
      <% }); %>
      <% if (!transactions.length) { %><p class="text-text2 text-sm">Belum ada transaksi.</p><% } %>
    </div>
  </main>
</div>

<script>
const csrfToken = '<%= csrfToken %>';
async function resolveDispute(id, action) {
  if (!confirm(action === 'refund' ? 'Refund escrow ke creator?' : 'Dismiss sengketa?')) return;
  const res = await fetch('/api/admin/dispute/' + id, {
    method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
    body: JSON.stringify({ action })
  });
  const data = await res.json();
  alert(data.success ? 'Berhasil' : data.error);
  location.reload();
}
</script>